{
  "name": "@lvshrd/kunlun-cli",
  "version": "0.2.3",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "让 AI 通过昆仑智联开放平台替你处理文档等办公操作",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvshrd/kunlun_cli.git"
  },
  "homepage": "https://github.com/lvshrd/kunlun_cli#readme",
  "bugs": "https://github.com/lvshrd/kunlun_cli/issues",
  "bin": {
    "kunlun-cli": "./dist/main.js"
  },
  "files": [
    "dist/**/*.js",
    "skills/**/*.md"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "package": "node scripts/package.mjs",
    "install:local": "npm run package && powershell.exe -NoProfile -ExecutionPolicy Bypass -File release/install.ps1",
    "test:package": "node scripts/test-package.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2"
  }
}
