{
  "name": "kunlun-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "让 AI 通过昆仑智联开放平台替你处理文档等办公操作",
  "bin": {
    "kunlun": "./dist/main.js"
  },
  "files": [
    "dist/**/*.js",
    "docs/*.md",
    ".cursor/skills/**/*.md",
    "ARCHITECTURE.md",
    "可行性分析与开发计划.md"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "package": "node scripts/package.mjs",
    "install:local": "npm run package && powershell.exe -NoProfile -ExecutionPolicy Bypass -File release/install.ps1",
    "test:package": "node scripts/test-package.mjs",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2"
  }
}
